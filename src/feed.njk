---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" />
  <link href="{{ site.url }}/" />
  <updated>{{ collections.posts[0].date | dateToRfc3339 }}</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.author.name }}</name>
    {%- if site.author.email %}
    <email>{{ site.author.email }}</email>
    {%- endif %}
  </author>
  <generator>Eleventy</generator>
  {%- for post in collections.posts %}
  {%- set postUrl = post.url | absoluteUrl(site.url) %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ postUrl }}" />
    <id>{{ postUrl }}</id>
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    <summary>{{ post.data.summary or post.data.title }}</summary>
    <content type="html" xml:base="{{ postUrl }}">{{ post.templateContent | htmlToAbsoluteUrls(postUrl) }}</content>
  </entry>
  {%- endfor %}
</feed>
