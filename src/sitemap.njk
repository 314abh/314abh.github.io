---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for item in collections.all %}
  {%- if item.url and "/404.html" not in item.url and "/tags/" not in item.url %}
  <url>
    <loc>{{ item.url | absoluteUrl(site.url) }}</loc>
    {%- if item.data.tags and "posts" in item.data.tags and item.date %}
    <lastmod>{{ item.date | machineDate }}</lastmod>
    {%- endif %}
  </url>
  {%- endif %}
  {%- endfor %}
  {%- for tag in collections.tagList %}
  <url>
    <loc>{{ ("/tags/" + (tag | slugify) + "/") | absoluteUrl(site.url) }}</loc>
  </url>
  {%- endfor %}
</urlset>
