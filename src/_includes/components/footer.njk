<footer class="site-footer">
  <nav class="webring" aria-label="{{ site.webring.name }}">
    <span class="webring__label">{{ site.webring.name }}:</span>
    <a href="{{ site.webring.home }}">?</a>
    <span aria-hidden="true">←</span>
    <a href="{{ site.webring.home }}">home</a>
    <span aria-hidden="true">→</span>
    <a href="{{ site.webring.home }}">?</a>
  </nav>

  <ul class="buttons" aria-label="web badges">
    {% for button in buttons %}
    <li><a href="{{ button.url }}"{% if button.url.startsWith('http') %} rel="noopener"{% endif %}><img src="{{ button.img }}" alt="{{ button.alt }}" width="88" height="31" loading="lazy"></a></li>
    {% endfor %}
  </ul>

  <p class="footer-note">
    No cookies, no trackers, no JavaScript needed to read this. Just text and pixels.
  </p>

  <p class="footer-links">
    {% for item in site.social %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}
  </p>

  <p class="footer-legal">
    &copy; {{ build.year }} {{ site.author.name }} · content under
    <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license noopener">CC BY-SA 4.0</a>
    · <a href="/feed.xml">subscribe</a>
  </p>
</footer>
